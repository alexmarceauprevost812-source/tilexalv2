.sidebar{
  width: 290px;
  min-width: 290px;
  height: 100vh;
  background: rgba(12,12,12,0.88);
  backdrop-filter: blur(16px);
  border-right: 1px solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18px;
  color: #fff;
  box-shadow: 8px 0 30px rgba(0,0,0,0.25);
}

.sidebar-top{
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.brand{
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon{
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 20px;
  background: linear-gradient(135deg, #ff3c00, #ff9900);
  box-shadow: 0 0 20px rgba(255,80,0,0.35);
}

.brand-text h2{
  margin: 0;
  font-size: 22px;
  line-height: 1;
}

.brand-text span{
  font-size: 13px;
  color: #bdbdbd;
}

.new-chat-btn{
  border: none;
  border-radius: 14px;
  padding: 14px 16px;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  cursor: pointer;
  background: linear-gradient(135deg, #ff3c00, #ff8800);
  box-shadow: 0 0 20px rgba(255,80,0,0.25);
  transition: 0.25s ease;
}

.new-chat-btn:hover{
  transform: translateY(-1px) scale(1.01);
}

.main-menu{
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 22px;
}

.menu-item{
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
  color: #fff;
  border-radius: 14px;
  padding: 14px 16px;
  cursor: pointer;
  font-size: 15px;
  text-align: left;
  transition: 0.25s ease;
}

.menu-item:hover{
  background: rgba(255,80,0,0.08);
  border-color: rgba(255,80,0,0.25);
  transform: translateX(2px);
}

.menu-item.active{
  background: linear-gradient(135deg, rgba(255,60,0,0.18), rgba(255,130,0,0.10));
  border-color: rgba(255,80,0,0.32);
  box-shadow: 0 0 20px rgba(255,80,0,0.10);
}

.icon{
  width: 22px;
  text-align: center;
  font-size: 16px;
}

.sidebar-middle{
  margin-top: 24px;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.section-title{
  margin: 0 0 12px;
  font-size: 13px;
  color: #9b9b9b;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.history-list{
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow-y: auto;
  padding-right: 4px;
}

.history-item{
  width: 100%;
  text-align: left;
  border: 1px solid rgba(255,255,255,0.06);
  background: rgba(255,255,255,0.025);
  color: #dcdcdc;
  border-radius: 12px;
  padding: 12px 14px;
  cursor: pointer;
  transition: 0.25s ease;
}

.history-item:hover{
  background: rgba(255,60,0,0.07);
  color: #fff;
}

.sidebar-bottom{
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 18px;
}

.profile-card{
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
}

.profile-avatar{
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  background: linear-gradient(135deg, #ff3c00, #ff9900);
  color: #fff;
}

.profile-info{
  display: flex;
  flex-direction: column;
}

.profile-info strong{
  font-size: 15px;
}

.profile-info span{
  font-size: 12px;
  color: #b0b0b0;
}

.theme-toggle-btn{
  border: none;
  border-radius: 14px;
  padding: 13px 16px;
  font-weight: 700;
  cursor: pointer;
  color: #fff;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  transition: 0.25s ease;
}

.theme-toggle-btn:hover{
  background: rgba(255,80,0,0.10);
  border-color: rgba(255,80,0,0.25);
}
