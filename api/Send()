async function send(){
  const text = input.value.trim();
  if(!text) return;

  addMsg(text, "me");
  input.value = "";

  // Affiche un message temporaire
  addMsg("...", "ai");

  // Envoie au backend Vercel (qui appelle OpenAI)
  const resp = await fetch("/api/chat", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ message: text })
  });

  const data = await resp.json();

  // Supprime le dernier "..." (facultatif)
  wrap.lastElementChild?.remove();

  if(!resp.ok){
    addMsg("Erreur GPT ❌ " + (data.error || ""), "ai");
    return;
  }

  addMsg(data.reply || "(vide)", "ai");
}
